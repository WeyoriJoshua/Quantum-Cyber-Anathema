    "        \"source_file\": path.name,\n",
    "        \"rows\": len(probe),\n",
    "        \"benign\": int(counts.get(\"BENIGN\", 0)),\n",
    "        \"PortScan\": int(counts.get(\"PortScan\", 0)),\n",
